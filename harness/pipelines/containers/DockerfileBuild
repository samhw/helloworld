FROM nexus-gss.uscis.dhs.gov:8110/ubuntu_26.04_java:21_corretto AS base

FROM base AS builder

USER root

ENV OPENSSL_FORCE_FIPS_MODE=0

RUN apt-get update -y \
  && apt-get install -y --no-install-recommends unzip git \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

ENV OPENSSL_FORCE_FIPS_MODE=1

RUN mkdir -p /app \
  && chown appuser:appuser /app

USER appuser 

WORKDIR /app

COPY --chown=appuser:appuser . .

FROM builder AS assembler

RUN ./gradlew clean bootJar --no-daemon

FROM base AS release

USER root

EXPOSE 8080

# Static Proxy configuration
ENV TARGET_DEPLOY_ENV="" \
    http_proxy="http://pzen.apps.dhs.gov:10029" \
    https_proxy="http://pzen.apps.dhs.gov:10029" \
    no_proxy=localhost,127.0.0.1,10.*,*.dhs.gov,uscis.dhs.gov,*.cluster.local,s3.us-east-1.amazonaws.com,*.s3.amazonaws.com,*.s3.us-east-1.amazonaws.com,169.254.169.254,169.254.170.2

COPY --chown=appuser:appuser build.stat[s] /opt/statz/

WORKDIR /app

COPY --chown=appuser:appuser .harness/pipelines/scripts/entrypoint.sh .
COPY --chown=appuser:appuser --from=assembler /app/build/libs/app.jar app.jar
COPY --chown=appuser:appuser newrelic.yml .

RUN chmod +x entrypoint.sh \
  && sh -c 'touch app.jar' \
  && mkdir -p keystore secrets \
  && chown -R appuser:appuser /app

USER appuser

ENTRYPOINT ["./entrypoint.sh"]
